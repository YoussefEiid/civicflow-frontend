# ==============================================================================
# CivicFlow Backend Environment Configuration
# ==============================================================================

# Application Environment (development | test | production)
NODE_ENV=production

# Server Port
PORT=5000

# Allowed Frontend URL for CORS & Cookie Domain
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Connection String
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&connection_limit=10
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/civicflow_db?schema=public"

# JWT Security Secrets & Expirations (MUST be replaced with long random strings in production)
JWT_ACCESS_SECRET="generate_a_very_long_secure_random_string_for_access_secret_64_chars"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="generate_a_very_long_secure_random_string_for_refresh_secret_64_chars"
JWT_REFRESH_EXPIRES_IN="7d"

# Storage Configuration (local | s3 | cloudinary)
STORAGE_PROVIDER="local"
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=25

# WhatsApp Integration (mock | cloud_api)
WHATSAPP_PROVIDER="mock"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
